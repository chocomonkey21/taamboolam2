# Copy to .env.local for local work. Never commit a filled-in copy — .gitignore
# already excludes every .env file except this one.
#
# In production these live in the hosting project (Vercel → Settings →
# Environment Variables), NOT in a file. Changing one there needs a redeploy
# before it takes effect.

# --- Mail -------------------------------------------------------------------

# Required in production. Without it the enquiry API answers 503 and the form
# tells the guest plainly that it cannot send, rather than showing a thank-you
# for a message that went nowhere.
#
# Create a key at https://resend.com/api-keys, on the account that owns the
# verified sending domain.
RESEND_API_KEY=

# Where enquiries land. Optional: with nothing set, the mailer falls back to
# contact.email in lib/site.ts, which is the owner's inbox — so a misconfigured
# hosting project still delivers somewhere real.
#
# Set it only to route mail somewhere else on purpose. Testing is the usual
# reason: point it at your own address, submit a few enquiries, then remove it
# again so the owner starts receiving them.
# ENQUIRY_TO_EMAIL=

# Who the mail comes FROM, and the one value with no sensible default.
#
# Resend — like every transactional provider — will only send from a domain
# whose DNS you have verified. A Gmail address can receive mail and can never
# send it, so this has to be on taamboolam.com.
ENQUIRY_FROM_EMAIL=Taamboolam <enquiries@taamboolam.com>

# --- Development only -------------------------------------------------------

# Review the confirmation screen without a live mail account. The enquiry is
# logged to the server terminal, nothing is sent, and the success screen says
# on screen that nothing was delivered. Never set this in production.
# ENQUIRY_DRY_RUN=true
