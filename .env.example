# --- Mail -------------------------------------------------------------------
# Required in production. Without it the enquiry API returns 503 and the form
# tells the guest plainly that it cannot send, rather than showing a thank-you
# for a message that went nowhere.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries land. The owner's inbox.
ENQUIRY_TO_EMAIL=stay@taamboolam.com

# Must be an address on a domain verified with the mail provider.
ENQUIRY_FROM_EMAIL=Taamboolam <enquiries@taamboolam.com>

# --- Development only -------------------------------------------------------
# Lets you review the confirmation screen without a live mail account. The
# enquiry is logged to the server terminal, nothing is sent, and the success
# screen says on screen that nothing was delivered. Never set in production.
# ENQUIRY_DRY_RUN=true
